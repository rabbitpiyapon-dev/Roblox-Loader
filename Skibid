-- ESP สำหรับผู้เล่นที่มองเห็นได้ในแมพของคุณ
local highlights = {}

local function addPlayerESP(target)
    if target == player or highlights[target] then return end

    local function attach(character)
        if not states.ESP or not character or not character.Parent then
            return
        end

        if highlights[target] then
            highlights[target]:Destroy()
        end

        local h = Instance.new("Highlight")
        h.Name = "CameraTD_PlayerESP"
        h.Adornee = character
        h.FillColor = Color3.fromRGB(30, 255, 90)
        h.OutlineColor = Color3.fromRGB(130, 255, 160)
        h.FillTransparency = 0.65
        h.DepthMode = Enum.HighlightDepthMode.Occluded
        h.Parent = character
        highlights[target] = h
    end

    if target.Character then
        attach(target.Character)
    end

    target.CharacterAdded:Connect(function(character)
        task.wait(0.5)
        attach(character)
    end)
end

setFeature.ESP = function(enabled)
    if enabled then
        for _, target in ipairs(Players:GetPlayers()) do
            addPlayerESP(target)
        end
    else
        for target, h in pairs(highlights) do
            if h then h:Destroy() end
            highlights[target] = nil
        end
    end
end

Players.PlayerAdded:Connect(function(target)
    if states.ESP then addPlayerESP(target) end
end)

Players.PlayerRemoving:Connect(function(target)
    if highlights[target] then
        highlights[target]:Destroy()
        highlights[target] = nil
    end
end)

