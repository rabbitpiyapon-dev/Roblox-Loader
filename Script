local function addToggle(title, description, callback)
    local row = Instance.new("Frame")
    row.Size = UDim2.new(1, -8, 0, 68)
    row.BackgroundColor3 = Color3.fromRGB(27, 35, 48)
    row.Parent = content
    corner(row, 10)

    local name = Instance.new("TextLabel")
    name.Size = UDim2.new(1, -100, 0, 27)
    name.Position = UDim2.fromOffset(12, 5)
    name.BackgroundTransparency = 1
    name.Text = title
    name.TextColor3 = Color3.new(1, 1, 1)
    name.Font = Enum.Font.GothamBold
    name.TextSize = 14
    name.TextXAlignment = Enum.TextXAlignment.Left
    name.Parent = row

    local desc = Instance.new("TextLabel")
    desc.Size = UDim2.new(1, -100, 0, 24)
    desc.Position = UDim2.fromOffset(12, 32)
    desc.BackgroundTransparency = 1
    desc.Text = description
    desc.TextColor3 = Color3.fromRGB(160, 175, 190)
    desc.Font = Enum.Font.Gotham
    desc.TextSize = 10
    desc.TextWrapped = true
    desc.TextXAlignment = Enum.TextXAlignment.Left
    desc.Parent = row

    local enabled = false
    local toggle = makeButton(
        row, "OFF", Color3.fromRGB(180, 60, 65),
        UDim2.fromOffset(66, 32)
    )
    toggle.Position = UDim2.new(1, -76, 0.5, -16)

    toggle.Activated:Connect(function()
        enabled = not enabled
        toggle.Text = enabled and "ON" or "OFF"
        toggle.BackgroundColor3 = enabled
            and Color3.fromRGB(25, 195, 110)
            or Color3.fromRGB(180, 60, 65)
        callback(enabled)
    end)
end

