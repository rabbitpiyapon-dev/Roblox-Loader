local function getRoot()
    local character = Player.Character
    return character and character:FindFirstChild("HumanoidRootPart")
end

local function savePosition()
    local root = getRoot()
    if root then
        savedCFrame = root.CFrame
        saveButton.Text = "✓"
        task.delay(1, function()
            if saveButton.Parent then saveButton.Text = "S" end
        end)
    end
end

local function teleportBack()
    local root = getRoot()
    if root and savedCFrame then
        root.CFrame = savedCFrame + Vector3.new(0, 3, 0)
    elseif not savedCFrame then
        teleportButton.Text = "?"
        task.delay(1, function()
            if teleportButton.Parent then teleportButton.Text = "T" end
        end)
    end
end

saveButton.Activated:Connect(savePosition)
teleportButton.Activated:Connect(teleportBack)

--================ ESP =====================================

local function clearESP()
    for target, highlight in pairs(espObjects) do
        if highlight then highlight:Destroy() end
        espObjects[target] = nil
    end
end

local function updateESP()
    if not espEnabled then
        clearESP()
        return
    end

    for _, target in ipairs(Players:GetPlayers()) do
        if target ~= Player and target.Character then
            local character = target.Character
            if not espObjects[character] then
                local h = Instance.new("Highlight")
                h.Name = "GameHubPlayerESP"
                h.Adornee = character
                h.FillColor = Color3.fromRGB(255, 45, 55)
                h.OutlineColor = Color3.fromRGB(255, 120, 120)
                h.FillTransparency = 0.55
                h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                h.Parent = gui
                espObjects[character] = h
            end
        end
    end

    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj:IsA("Model")
            and (obj.Name == "Pumpkin Gold"
            or obj.Name == "Pumpkin Silver")
            and not espObjects[obj] then

            local h = Instance.new("Highlight")
            h.Name = "GameHubPumpkinESP"
            h.Adornee = obj
            h.FillColor = Color3.fromRGB(255, 220, 40)
            h.OutlineColor = Color3.fromRGB(255, 245, 150)
            h.FillTransparency = 0.4
            h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
            h.Parent = gui
            espObjects[obj] = h
        end
    end
end

