    if h then h:Destroy() end
    playerHighlights[target] = nil
end)

player.CharacterAdded:Connect(function()
    task.wait(1)

    if states.ESP then
        scanESP()
    end

    if states.FLY then
        setFeature.FLY(true)
    end
end)

